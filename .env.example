# =======================================================
# AI Resume Analyzer and ATS Score Checker Configuration
# =======================================================
# NOTE: The application operates fully offline with complete
# functionality without paid API keys. These keys are optional.

# Google Gemini API Key (Optional)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face API Token (Optional)
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Application Preferences
ENABLE_HISTORY=true
MAX_FILE_SIZE_MB=10
